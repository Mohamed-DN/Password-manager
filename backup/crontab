# backup/crontab
# Cron schedule for the backup container.
#
# Format: minute hour day-of-month month day-of-week command
#
# RETENTION POLICY
# ─────────────────────────────────────────────────────────────────
# Local (inside the backup container / backups_data volume):
#   7 daily pg_dumps + 7 daily vault snapshots  →  RETENTION_DAYS=7
# Offsite (oemdb1:/backup/nexi-vault-backups):
#   30 daily copies                             →  OFFSITE_RETENTION_DAYS=30
#   oemdb1 has 40 TB free; 30 days of compressed
#   pg_dumps for a password manager is well under 1 GB total.
# ─────────────────────────────────────────────────────────────────

# Daily backup at 02:00 — pg_dump + vault raft snapshot
0 2 * * * /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1

# Daily offsite copy at 02:30 — rsync everything to oemdb1:/backup/nexi-vault-backups
# Runs 30 minutes after the backup to ensure files are complete.
# This is a no-op when OFFSITE_HOST is not set.
30 2 * * * /usr/local/bin/offsite-copy.sh >> /var/log/backup.log 2>&1

# Weekly integrity check: verify the most recent pg_dump can be read by pg_restore.
# Runs every Sunday at 04:00.
0 4 * * 0 pg_restore --list $(ls -t /backups/postgres/*.dump 2>/dev/null | head -1) \
          > /dev/null 2>&1 && echo "[integrity-check] OK" >> /var/log/backup.log \
          || echo "[integrity-check] WARN: latest dump unreadable!" >> /var/log/backup.log
