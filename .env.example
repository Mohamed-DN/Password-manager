# ---------------------------------------------------------------------------
# .env.example — Nexi Vault environment template
# Copy to .env and fill in the values before running podman-compose or
# the deploy.sh script.
#
#   cp .env.example .env
#   chmod 600 .env          # protect credentials
#   $EDITOR .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Offsite backup (oemdb1 gateway — 40 TB at /backup)
# ---------------------------------------------------------------------------

# Hostname or IP of the backup server
OFFSITE_HOST=oemdb1

# SSH port on the backup server (default: 22)
OFFSITE_PORT=22

# SSH user on the backup server (create this user on oemdb1 before deploying)
OFFSITE_USER=backup

# Remote directory where backups are written
OFFSITE_PATH=/backup/nexi-vault-backups

# Path to the SSH private key INSIDE the backup container.
# The key is generated by podman/setup-offsite-ssh.sh and must be mounted
# into the container (see the commented volume entry in podman-compose.yml).
OFFSITE_SSH_KEY=/root/.ssh/id_rsa

# Path to the SSH known_hosts file INSIDE the backup container.
# Populated automatically by setup-offsite-ssh.sh.  Leave empty to skip
# strict host-key checking (acceptable only on isolated private networks).
OFFSITE_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts

# ---------------------------------------------------------------------------
# PostgreSQL replication mode
# Set to 'sync' for synchronous replication (stronger durability guarantee —
# primary waits for standby WAL write before confirming commit).
# Leave as 'async' for better write performance (default for most workloads).
# ---------------------------------------------------------------------------
REPLICATION_MODE=async

# ---------------------------------------------------------------------------
# JWT Authentication configuration
# ---------------------------------------------------------------------------
# Secret key for JWT token signing (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Internal service credentials
# Change ALL of these before deploying to production.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=rootpassword123
REPLICATION_PASSWORD=ReplicaPassword123!
INVENTORY_APP_PASSWORD=PasswordBackend123!
VAULT_INIT_FILE=/vault/init/init.json
